<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="petcare_companion.db" />
        <include domain="database" path="petcare_companion.db-wal" />
        <include domain="database" path="petcare_companion.db-shm" />
        <include domain="file" path="pets/" />
        <include domain="file" path="datastore/petcare_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="petcare_companion.db" />
        <include domain="database" path="petcare_companion.db-wal" />
        <include domain="database" path="petcare_companion.db-shm" />
        <include domain="file" path="pets/" />
        <include domain="file" path="datastore/petcare_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
